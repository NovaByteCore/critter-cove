<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cc_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="10dp"
    android:background="@drawable/cc_widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView android:id="@+id/cc_emoji" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="20sp" android:text="🦝" />
        <TextView android:id="@+id/cc_where" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="6dp" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.06"
            android:textColor="@color/cc_muted" android:maxLines="1" android:ellipsize="end" android:text="NEXT TINY THING" />
        <TextView android:id="@+id/cc_shells" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="13sp" android:textStyle="bold" android:textColor="@color/cc_ink" android:text="" />
    </LinearLayout>

    <TextView android:id="@+id/cc_task" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/cc_ink"
        android:maxLines="2" android:ellipsize="end" android:text="Open Critter Cove once to set up your widget." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView android:id="@+id/cc_done" android:layout_width="0dp" android:layout_weight="1" android:layout_height="42dp"
            android:gravity="center" android:background="@drawable/cc_done_bg"
            android:textSize="16sp" android:textStyle="bold" android:textColor="@color/cc_on" android:text="Done ✓"
            android:contentDescription="Mark this tiny thing done" />
        <TextView android:id="@+id/cc_chest" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:textSize="12sp" android:textColor="@color/cc_muted"
            android:maxLines="2" android:ellipsize="end" android:text="" />
    </LinearLayout>

    <TextView android:id="@+id/cc_line" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textSize="12sp" android:textStyle="italic" android:textColor="@color/cc_muted"
        android:maxLines="1" android:ellipsize="end" android:text="" />
</LinearLayout>
